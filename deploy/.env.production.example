# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public hostname Caddy serves (DNS A record must point at this server).
DOMAIN=dm.example.com

# ---- App ----
NEXTAUTH_URL=https://dm.example.com
NEXTAUTH_SECRET=            # openssl rand -base64 32
CRON_SECRET=                # openssl rand -base64 32
ENCRYPTION_KEY=             # openssl rand -hex 32  (exactly 64 hex chars)

# ---- Database / queue (internal compose hostnames) ----
POSTGRES_PASSWORD=          # openssl rand -hex 24
DATABASE_URL=postgresql://openreply:<POSTGRES_PASSWORD>@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# ---- Email magic links ----
# Either Resend (verified sender domain) or your own SMTP via EMAIL_SERVER.
RESEND_API_KEY=
EMAIL_FROM=OpenReply <login@example.com>
# EMAIL_SERVER=smtps://user%40example.com:password@smtp.example.com:465
ALLOWED_EMAILS=you@example.com

# ---- Meta / Instagram ----
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# ---- Legal pages (privacy / terms / data deletion; required for Meta App Review) ----
LEGAL_PRODUCT_NAME=Your Product
LEGAL_OPERATOR_NAME=Your Company LLC
LEGAL_OPERATOR_REGISTRATION=Tax ID 000000
LEGAL_OPERATOR_ADDRESS=Street 1, City, Country
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_SUBPROCESSORS=Hetzner (hosting), PostgreSQL and Redis on our own server, Resend (email)
